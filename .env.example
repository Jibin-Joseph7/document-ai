# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
SQLITE_PATH=./server/data/document_ai.sqlite
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
AI_SERVICE_URL=http://localhost:8000

# AI Service
AI_SERVICE_PORT=8000
CHROMA_PERSIST_DIR=./ai-service/chroma_store
EMBEDDING_PROVIDER=local

# Optional OpenAI
OPENAI_API_KEY=

# LLM
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini